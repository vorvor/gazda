<div class="shop-full">
  <div class="shop-image">
    {{ content.field_images }}
  </div>
  <div class="shop-open-hours">
    {{ content.field_open_hours }}
  </div>
  <div class="shop-details">
    {{ content|without('field_images', 'field_open_hours') }}
    <a class="shop-on-map" target="_blank" href="https://www.google.com/maps/place/{{ content.field_address[0]['#context']['value'] }}">Térkép</a>
  </div>
</div>
