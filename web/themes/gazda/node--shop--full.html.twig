<article{{ attributes.addClass('shop-full', 'shop-detail') }}>
  <header class="shop-header shop-detail-hero">
    {% if node.field_logo.entity %}
      <div class="shop-logo">
        <img src="{{ file_url(node.field_logo.entity.fileuri) }}" alt="{{ node.field_logo.alt }}" />
      </div>
    {% endif %}
    <div class="shop-detail-heading">
      <p class="shop-detail-eyebrow">{{ 'Helyi üzlet Szentendrén'|t }}</p>
      <h1 class="shop-title">{{ label }}</h1>
      {% if google_review_rating %}
        <a class="shop-google-rating" href="{{ google_review_rating.google_maps_uri }}" target="_blank" rel="noopener noreferrer" aria-label="{{ 'Google-értékelés: @rating az 5-ből, @count vélemény alapján'|t({'@rating': google_review_rating.rating|number_format(1, ','), '@count': google_review_rating.review_count}) }}">
          <span class="shop-google-rating__source"><img src="/{{ base_path ~ directory }}/images/google-logo.png" alt="Google" width="74" height="24" /></span>
          <span class="shop-google-rating__score">{{ google_review_rating.rating|number_format(1, ',') }}</span>
          <span class="shop-google-rating__stars" aria-hidden="true">★★★★★</span>
          <span class="shop-google-rating__count">({{ google_review_rating.review_count }} {{ 'vélemény'|t }})</span>
        </a>
      {% endif %}
    </div>
  </header>

  <div class="shop-detail-grid">
    <section class="shop-image shop-detail-card shop-detail-card--media" aria-label="{{ 'Üzlet képei'|t }}">
      {{ content.field_images }}
    </section>

    <div class="shop-detail-sidebar">
      <section class="shop-open-hours shop-detail-card shop-detail-card--hours{% if public_holiday_active %} has-public-holiday{% endif %}">
        <h2>{{ 'Nyitvatartás'|t }}</h2>
        {{ public_holiday_block }}
        {{ content.field_open_hours }}
      </section>

      <section class="shop-details shop-detail-card shop-detail-card--contact">
        <h2>{{ 'Elérhetőségek'|t }}</h2>
        {{ content|without('field_images', 'field_open_hours', 'daily_coupon', 'field_logo', 'field_phone', 'field_google_place_id') }}
        <a class="shop-on-map" target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps/place/{{ content.field_address[0]['#context']['value'] }}">{{ 'Megnyitás térképen'|t }}</a>
        <div class="shop-phone">
          {% for key, item in content.field_phone %}
            {% if key|first != '#' %}
              <a href="tel:{{ item['#context']['value']|striptags|trim }}"><i class="fa-solid fa-phone" aria-hidden="true"></i> {{ item['#context']['value'] }}</a>
            {% endif %}
          {% endfor %}
        </div>
        {{ content.daily_coupon }}
      </section>
    </div>
  </div>
</article>
