<?php

/**
 * @file
 * Functions to support theming in the Gazda theme.
 */

use Drupal\node\NodeInterface;
use Drupal\Component\Utility\Html;
use Drupal\Component\Utility\UrlHelper;

/**
 * Helper function to clean and transliterate strings for CSS classes.
 */
function _gazda_clean_string($string) {
  // Transliterate to remove accents.
  $transliterated = \Drupal::transliteration()->transliterate($string, 'hu');
  // Lowercase and take first 6 chars.
  $short = mb_substr(mb_strtolower($transliterated), 0, 6);
  // Clean for CSS.
  return Html::getClass($short);
}

/**
 * Implements hook_preprocess_html().
 */
function gazda_preprocess_html(&$variables) {
  $shop_name = '';

  // 1. Try to get shop from the current route (if it's a shop node page).
  $node = \Drupal::routeMatch()->getParameter('node');
  if ($node instanceof NodeInterface) {
    if ($node->bundle() === 'shop') {
      $shop_name = $node->label();
    }
    elseif ($node->bundle() === 'product' && $node->hasField('field_shop') && !$node->get('field_shop')->isEmpty()) {
      $shop_node = $node->get('field_shop')->entity;
      if ($shop_node instanceof NodeInterface) {
        $shop_name = $shop_node->label();
      }
    }
  }

  // 2. Fallback to site name if no shop context found.
  if (empty($shop_name)) {
    $shop_name = \Drupal::config('system.site')->get('name');
  }

  if (!empty($shop_name)) {
    $clean_class = _gazda_clean_string($shop_name);
    // Add to body classes.
    $variables['attributes']['class'][] = 'shop-' . $clean_class;
  }
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function gazda_preprocess_views_view_unformatted(&$variables) {
  $view = $variables['view'];
  if ($view->id() === 'products') {
    foreach ($variables['rows'] as $id => $row) {
      $node = $row['content']['#row']->_entity;
      if ($node instanceof NodeInterface && $node->bundle() === 'product' && $node->hasField('field_shop') && !$node->get('field_shop')->isEmpty()) {
        $shop_node = $node->get('field_shop')->entity;
        if ($shop_node instanceof NodeInterface) {
          $shop_name = $shop_node->label();
          $clean_class = _gazda_clean_string($shop_name);
          $variables['rows'][$id]['attributes']->addClass('shop-' . $clean_class);
        }
      }
    }
  }
}
