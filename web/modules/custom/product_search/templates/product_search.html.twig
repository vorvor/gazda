<div class="product-search-widget product-search-block">
  <div class="search-widget-header">
    <h2>Fedezd fel, mi minden kapható Szentendrén helyben!</h2>
    <p>Helyi üzletek termékei, egy helyen. Nézelődj, inspirálódj, szerezd be!</p>
  </div>
  <div class="product-search-form">
    <input
      id="product-search-input"
      class="product-search-input"
      type="text"
      autocomplete="off"
      placeholder="{{ placeholder }}" />
    <span class="search-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
  </div>
  {% if marketingblock %}
    <div id="marketing-block" class="marketing-block">
      {{ marketingblock }}
    </div>
  {% endif %}
  <div
    id="product-search-results"
    class="product-search-results"
    aria-live="polite">

    {{ results }}

  </div>
</div>




