<?php

/**
 * Implements hook_theme().
 */
function product_search_theme($existing, $type, $theme, $path) {
  return [
    'product_search' => [
      'variables' => [
        'placeholder' => NULL,
        'marketingblock' => NULL,
        'results' => NULL,
        'is_front' => FALSE,
        'local_offering_count' => 0,
        'shop_count' => 0,
        'hero_shop_name' => '',
        'hero_shop_url' => '',
        'hero_shop_image_url' => '',
        'hero_shop_image_alt' => '',
        'hero_shop_summary' => '',
        'search_suggestions' => [],
      ],
      'template' => 'product_search',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for product_search.
 */
function product_search_preprocess_product_search(&$variables) {
  try {
    $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  }
  catch (\Exception $e) {
    $variables['is_front'] = FALSE;
  }
}

/**
 * Implements hook_preprocess_html().
 */
function product_search_preprocess_html(&$variables) {
  $variables['current_path'] = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($variables['current_path']);
  if ($alias !== $variables['current_path']) {
    $variables['current_path_alias'] = $alias;
  }
}
