<?php

/**
 * @file
 * Contains generate_marketing_text.module.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\node\NodeInterface;
use Drupal\Component\Serialization\Json;
use GuzzleHttp\Exception\GuzzleException;

/**
 * Implements hook_entity_presave().
 */
function generate_marketing_text_entity_presave(EntityInterface $entity) {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'product') {
    \Drupal::logger('generate_marketing_text')->notice('Presave triggered for product node: @id', ['@id' => $entity->id()]);

    if ($entity->hasField('field_marketing_text') && !$entity->get('field_marketing_text')->isEmpty()) {
      \Drupal::logger('generate_marketing_text')->notice('Marketing text already exists for node @id, skipping generation.', ['@id' => $entity->id()]);
      return;
    }

    // Fallback check for field_description if field_marketing_text is missing.
    if (!$entity->hasField('field_marketing_text') && $entity->hasField('field_description') && !$entity->get('field_description')->isEmpty()) {
      \Drupal::logger('generate_marketing_text')->notice('Description already exists for node @id, skipping generation.', ['@id' => $entity->id()]);
      return;
    }

    $category_name = '';

    // Try to get category from field_category.
    if ($entity->hasField('field_category') && !$entity->get('field_category')->isEmpty()) {
      $term = $entity->get('field_category')->entity;
      if ($term) {
        $category_name = $term->label();
      }
    }

    // Fallback to field_tags if field_category is empty.
    if (empty($category_name) && $entity->hasField('field_tags') && !$entity->get('field_tags')->isEmpty()) {
      $term = $entity->get('field_tags')->entity;
      if ($term) {
        $category_name = $term->label();
      }
    }

    // Fallback to title if still empty.
    if (empty($category_name)) {
      $category_name = $entity->label();
    }

    $shop_name = '';
    if ($entity->hasField('field_shop') && !$entity->get('field_shop')->isEmpty()) {
      $shop_node = $entity->get('field_shop')->entity;
      if ($shop_node) {
        $shop_name = $shop_node->label();
      }
    }

    if ($category_name) {
      \Drupal::logger('generate_marketing_text')->notice('Generating text for: @cat (Shop: @shop)', [
        '@cat' => $category_name,
        '@shop' => $shop_name ?: 'Unknown',
      ]);
      $marketing_text = generate_marketing_text_from_chatgpt($category_name, $entity->label(), $shop_name);

      if ($marketing_text) {
        // Use field_marketing_text if it exists.
        if ($entity->hasField('field_marketing_text')) {
          $entity->set('field_marketing_text', $marketing_text);
          \Drupal::logger('generate_marketing_text')->notice('Marketing text set in field_marketing_text for node @id', ['@id' => $entity->id()]);
        }
        // Fallback to field_description if field_marketing_text does not exist.
        elseif ($entity->hasField('field_description')) {
          $entity->set('field_description', $marketing_text);
          \Drupal::logger('generate_marketing_text')->notice('Marketing text set in field_description for node @id', ['@id' => $entity->id()]);
        }
        else {
          \Drupal::logger('generate_marketing_text')->error('Neither field_marketing_text nor field_description exists on product node @id', ['@id' => $entity->id()]);
        }
      }
      else {
        \Drupal::logger('generate_marketing_text')->error('Failed to generate marketing text for node @id', ['@id' => $entity->id()]);
      }
    }
  }
}

/**
 * Calls ChatGPT API to generate marketing text.
 */
function generate_marketing_text_from_chatgpt($category, $product_title, $shop_name = '') {
  $config = \Drupal::config('generate_marketing_text.settings');
  $api_key = trim($config->get('chatgpt_api_key') ?? '');

  if (empty($api_key)) {
    \Drupal::logger('generate_marketing_text')->error('ChatGPT API Key is not configured.');
    return '';
  }

  \Drupal::logger('generate_marketing_text')->notice('API Key fetched: @key_length chars. Starts with: "@start"', [
    '@key_length' => strlen($api_key),
    '@start' => substr($api_key, 0, 7) . '...',
  ]);

  if (strpos($api_key, 'sk-') !== 0) {
    \Drupal::logger('generate_marketing_text')->warning('API Key does not start with "sk-". This is likely an invalid key format.');
  }

  $client = \Drupal::httpClient();

  $prompt = "You are the copywriter of the \"Sétálj be!\" platform.

The \"Sétálj be!\" platform is NOT an online shop.
Its purpose is to showcase unique products from local stores in Szentendre and encourage people to visit those specific shops in person.

Your task is to write a professional, SEO-optimized product recommendation in Hungarian.
The recommendation should highlight that the product is available at the shop: \"{$shop_name}\".

Do NOT write like an online webshop.
Write like a professional expert who knows the local shops and their quality well.

--------------------------------------------------

Product:
{$product_title}

Shop:
{$shop_name}

Category:
{$category}

--------------------------------------------------

## Writing style

The text must:

- Be written in Hungarian.
- Be between 60 and 120 words.
- Be professional, direct, and engaging.
- Use emojis naturally to make the tone friendlier but still professional.
- Focus on practical product benefits and quality.
- Incorporate the Product Title and the Shop Name naturally in the text.
- Include a clear call-to-action to visit the \"{$shop_name}\" store.
- Sound authentic and informative rather than sales-oriented.
- Never sound exaggerated or use empty marketing buzzwords.
- Never mention prices unless explicitly provided.
- Never promise stock or availability.
- Never compare the product to competitors.
- Never claim that the product is the best.

--------------------------------------------------

## Important

Assume that most products are ordinary everyday products.

Do NOT try to make them sound exciting if they are not.

For example:

A wrench is simply a wrench.

A paintbrush is simply a paintbrush.

A screwdriver is simply a screwdriver.

The goal is to introduce the product naturally.

Avoid openings such as:

- Tökéletes választás!
- Kiváló minőség!
- Ne keress tovább!
- Erre van szükséged!
- Megtaláltad!
- Ez kihagyhatatlan!

Instead, sound like a helpful shop assistant.
The reader should never feel that someone is trying to sell them something. They should simply feel that they have discovered a useful local store.

--------------------------------------------------

## When relevant

Naturally include:

- the product title \"{$product_title}\"
- what the product is used for
- who may find it useful
- situations where it can be useful
- that multiple sizes/colors/versions may exist
- that the store staff can help with choosing
- that the store offers many similar products
- the value of visiting a local specialty store
- encouragement to visit the store

Never force these topics.
Only mention what fits naturally.

--------------------------------------------------

## Variation

Every generated description should feel unique.

Rotate naturally between ideas such as:

- Érdemes személyesen is megnézni.
- Többféle változat közül is választhatsz.
- Az üzletben szívesen segítenek a választásban.
- Ha egy nagyobb projekthez keresel alapanyagokat, itt érdemes körülnézni.
- Lehet, hogy a fotón láthatón kívül is találsz hasonló termékeket.
- Akkor is érdemes benézni, ha csak ötleteket gyűjtesz.
- Sokszor olyan hasznos apróságokra is rábukkan az ember, amiket eredetileg nem is keresett.
- A személyes tanácsadás sokszor többet ér, mint egy internetes keresés.

Do not repeat the same structure for every product.

--------------------------------------------------

## Emojis

Use 3-7 emojis naturally.

The first line MUST begin with an emoji.

The last line MUST also begin with an emoji.

Prefer this structure:

- One emoji at the beginning to introduce the topic.
- One or two emojis inside the text to highlight important ideas.
- One emoji in the closing sentence.

Emojis should improve readability rather than decorate the text.

Examples:

🔧
🪴
🧵
🎨
✂️
🛠️
🌱
🏡
😊

Never place emojis after every sentence.

--------------------------------------------------

## Ending

Finish with one short natural closing sentence.

Examples:

- Nézz be hozzánk! 😊
- Érdemes személyesen is körülnézni.
- Ha kérdésed van, az üzlet munkatársai szívesen segítenek.
- Lehet, hogy pont ezt keresed.
- Érdemes benézni, és körülnézni a teljes kínálatban.

Choose a different ending each time.

--------------------------------------------------

## Self review

Before returning the text, silently ask yourself:

1. Would a real shop assistant honestly say this?

2. Does the text sound like a webshop advertisement?

3. Did I exaggerate an ordinary product?

If the answer to question 2 or 3 is YES,
rewrite the text in a more natural and modest way.

--------------------------------------------------

Return ONLY the final Hungarian text.

Do not explain your reasoning.

Do not use markdown.";


  try {
    \Drupal::logger('generate_marketing_text')->notice('Calling ChatGPT API with model gpt-4o-mini');

    $headers = [
      'Authorization' => 'Bearer ' . $api_key,
      'Content-Type' => 'application/json',
    ];

    $response = $client->post('https://api.openai.com/v1/chat/completions', [
      'headers' => $headers,
      'json' => [
        'model' => 'gpt-4o-mini',
        'messages' => [
          ['role' => 'system', 'content' => 'You are an expert ecommerce copywriter specialized in professional product descriptions.'],
          ['role' => 'user', 'content' => $prompt],
        ],
        'temperature' => 0.7,
      ],
    ]);

    $contents = $response->getBody()->getContents();
    \Drupal::logger('generate_marketing_text')->notice('ChatGPT API response received.');
    $data = Json::decode($contents);
    if (isset($data['choices'][0]['message']['content'])) {
      return trim($data['choices'][0]['message']['content']);
    }
    else {
      \Drupal::logger('generate_marketing_text')->error('ChatGPT API response structure unexpected: @data', ['@data' => json_encode($data)]);
    }
  }
  catch (GuzzleException $e) {
    $error_msg = $e->getMessage();
    \Drupal::logger('generate_marketing_text')->error('ChatGPT API error: @message', ['@message' => $error_msg]);

    // Check for specific common causes of 401.
    if (strpos($error_msg, '401') !== FALSE) {
      if (strpos($api_key, 'sk-proj-') === 0 && strlen($api_key) < 20) {
        \Drupal::logger('generate_marketing_text')->error('API key starts with "sk-proj-" but is very short. Project keys might have different permissions or require different usage.');
      }
    }
  }

  return NULL;
}
