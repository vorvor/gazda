.gspb_text{line-height:1.65 !important}
.ct-footer .gspb_text,.ct-footer p,.ct-footer a{color:rgba(255,255,255,.86) !important}
.ct-footer a:hover{color:#8dc056 !important}
#gspb_row-id-gsbp-c8a3d73{background-image:linear-gradient(100deg,rgba(15,31,47,.96) 0%,rgba(15,31,47,.92) 34%,rgba(15,31,47,.62) 60%,rgba(15,31,47,.42) 100%),url('https://nextro.hu/wp-content/uploads/2026/08/hero-legkezelo-gepterem.jpg') !important;background-size:cover !important;background-position:center right !important}
#gspb_row-id-gsbp-c8a3d73 .gspb_heading:first-of-type::before{content:'Teljeskörű légtechnikai megoldások';display:block;font-size:14px;letter-spacing:.16em;text-transform:uppercase;color:#8dc056;margin-bottom:14px;font-weight:600;animation:nx-fade .9s ease both}
@keyframes nx-fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@media (max-width:781px){#gspb_row-id-gsbp-c8a3d73{background-image:linear-gradient(rgba(15,31,47,.94),rgba(15,31,47,.88)),url('https://nextro.hu/wp-content/uploads/2026/08/hero-legkezelo-gepterem.jpg') !important}}
#gspb_iconBox-id-gsbp-c48cebb svg,#gspb_iconBox-id-gsbp-c48cebb svg path{fill:#5f9138 !important}
#gspb_iconBox-id-gsbp-68a53b7 svg,#gspb_iconBox-id-gsbp-68a53b7 svg path{fill:#4fa0d2 !important}
#gspb_iconBox-id-gsbp-efa10fd svg,#gspb_iconBox-id-gsbp-efa10fd svg path{fill:#ed9245 !important}
#gspb_iconBox-id-gsbp-802a4e5 svg,#gspb_iconBox-id-gsbp-802a4e5 svg path{fill:#8dc056 !important}
