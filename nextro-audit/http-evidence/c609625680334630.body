#gspb_row-id-gsbp-48b095b,#gspb_row-id-gsbp-58b0961{background-color:#F5F7F9 !important;padding-top:0 !important}
#gspb_row-id-gsbp-51fa19f,#gspb_row-id-gsbp-61fa1a6{padding-bottom:32px !important}
#gspb_row-id-gsbp-96b5086{padding-top:160px !important;padding-bottom:210px !important;margin-bottom:0 !important}
@media (max-width:999px){#gspb_row-id-gsbp-96b5086{padding-top:110px !important;padding-bottom:56px !important}}
#gspb_row-id-gsbp-6828801{margin-top:-170px !important;margin-bottom:0 !important;padding-top:0 !important;padding-bottom:64px !important}
@media (max-width:999px){#gspb_row-id-gsbp-6828801{margin-top:0 !important;padding-bottom:40px !important}}
@media (min-width:1000px){#gspb_row-id-gsbp-6828801>.gspb_row__content{align-items:flex-start}#gspb_image-id-gsbp-fe7e4de,#gspb_image-id-gsbp-1208112,#gspb_image-id-gsbp-241755f{height:300px !important;margin-top:0 !important}#gspb_image-id-gsbp-fe7e4de img,#gspb_image-id-gsbp-1208112 img,#gspb_image-id-gsbp-241755f img{width:100% !important;height:300px !important;object-fit:cover !important}}
.nx-grid--5,.nx-grid--sv{display:flex;flex-wrap:wrap;justify-content:center;gap:24px}
.nx-grid--5>*{flex:0 0 calc(25% - 18px)}
.nx-grid--sv>*{flex:0 0 calc(33.3333% - 16px)}
.nx-card{padding:34px 24px}
.nx-ic{width:62px;height:62px}
.nx-ic svg{width:38px;height:38px}
.nx-svc h3{font-size:15px;margin:14px 0 10px}
.nx-svc p{font-size:14px}
.nx-svc--full{padding:32px 30px}
@media (max-width:1100px){.nx-grid--5>*{flex-basis:calc(33.3333% - 16px)}}
@media (max-width:900px){.nx-grid--5>*,.nx-grid--sv>*{flex-basis:calc(50% - 12px)}}
