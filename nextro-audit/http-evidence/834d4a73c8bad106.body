.nx-section,.nx-marquee{width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}
.nx-section{padding:96px 0;background:#fff;color:var(--nx-navy)}
.nx-section--light{background:var(--nx-soft)}
.nx-section--dark{background:var(--nx-navy);color:#fff}
.nx-section--contact{background:var(--nx-soft)}
.nx-wrap{max-width:1200px;margin:0 auto;padding:0 24px}
.nx-h2{font-size:clamp(26px,2.4vw,36px);line-height:1.2;text-align:center;margin:0 auto 14px;color:inherit;font-weight:700;letter-spacing:-.01em}
.nx-h2::after{content:"";display:block;width:72px;height:3px;margin:16px auto 0;border-radius:2px;background:linear-gradient(90deg,var(--nx-g) 0 33%,var(--nx-b) 33% 66%,var(--nx-o) 66% 100%)}
.nx-h2--left{text-align:left;margin-left:0}
.nx-h2--left::after{margin-left:0}
.nx-lead{max-width:760px;margin:18px auto 0;text-align:center;font-size:16px;line-height:1.65;color:var(--nx-ink)}
.nx-section--dark .nx-lead{color:rgba(255,255,255,.82)}
.nx-lead--left{text-align:left;margin-left:0}
.nx-grid{display:grid;gap:20px;margin-top:44px}
.nx-grid--5{grid-template-columns:repeat(5,1fr)}
.nx-grid--3{grid-template-columns:repeat(3,1fr)}
.nx-card{display:block;background:#fff;border:1px solid var(--nx-line);border-radius:12px;padding:26px 20px;text-align:center;text-decoration:none;color:inherit;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
.nx-card:hover,.nx-card:focus-visible{transform:translateY(-4px);box-shadow:0 14px 30px rgba(15,31,47,.10);border-color:rgba(95,145,56,.45)}
.nx-ic{display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px}
.nx-ic svg{width:32px;height:32px}
.nx-g{color:var(--nx-g)}.nx-b{color:var(--nx-b)}.nx-o{color:var(--nx-o)}
.nx-svc h3{font-size:13.5px;line-height:1.35;text-transform:uppercase;letter-spacing:.04em;font-weight:700;margin:12px 0 8px;color:var(--nx-navy)}
.nx-svc p{font-size:13.5px;line-height:1.6;margin:0;color:#5c6b7a}
.nx-grid--sv{grid-template-columns:repeat(3,1fr)}
.nx-svc--full{text-align:left;padding:28px 26px}
.nx-svc--full h3{font-size:17px;text-transform:none;letter-spacing:0;line-height:1.3;margin:14px 0 10px}
.nx-svc--full .nx-svc-lead{font-weight:600;color:var(--nx-navy);margin:0 0 10px;font-size:14px}
.nx-svc--full p{font-size:14px}
.nx-cta-row{display:flex;justify-content:center;margin-top:40px}
.nx-btn{display:inline-flex;align-items:center;gap:10px;background:var(--nx-g-t);color:#fff !important;border:2px solid var(--nx-g-t);border-radius:6px;padding:14px 30px;font-weight:600;font-size:15px;text-decoration:none;transition:background .2s,color .2s,border-color .2s}
.nx-btn:hover{background:var(--nx-navy);border-color:var(--nx-navy);color:#fff !important}
.nx-btn--ghost{background:transparent;color:var(--nx-g-t) !important;border-color:var(--nx-g-t)}
.nx-btn--ghost:hover{background:var(--nx-g-t);color:#fff !important}
/* mozgó szöveg */
.nx-marquee{background:var(--nx-navy);overflow:hidden;padding:14px 0;border-top:3px solid var(--nx-o)}
.nx-mq-track{display:flex;width:max-content;animation:nx-scroll 46s linear infinite}
.nx-marquee:hover .nx-mq-track{animation-play-state:paused}
.nx-mq-i{color:#fff;font-size:14px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;white-space:nowrap;padding:0 4px}
.nx-mq-d{color:var(--nx-o);padding:0 18px}
@keyframes nx-scroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
/* referencia-slider */
.nx-slider{position:relative;margin-top:44px;display:flex;align-items:center;gap:12px}
.nx-viewport{overflow:hidden;flex:1;min-width:0}
.nx-track{display:flex;transition:transform .55s cubic-bezier(.4,0,.2,1)}
.nx-slide{flex:0 0 auto;width:33.3333%;padding:0 10px;box-sizing:border-box}
.nx-slide article,.nx-slide{min-width:0}
.nx-slide .nx-slide-img{border-radius:12px 12px 0 0;overflow:hidden;aspect-ratio:16/9;background:#e9edf1}
.nx-slide .nx-slide-img img{width:100%;height:100%;object-fit:cover;display:block}
.nx-slide-body{background:#fff;border:1px solid var(--nx-line);border-top:0;border-radius:0 0 12px 12px;padding:20px 20px 24px}
.nx-slide-body h3{font-size:16px;margin:0 0 10px;color:var(--nx-navy);line-height:1.35}
.nx-slide-body p{font-size:14px;line-height:1.65;color:var(--nx-ink);margin:0}
.nx-arrow{flex:0 0 auto;width:44px;height:44px;border-radius:50%;border:1px solid var(--nx-line);background:#fff;color:var(--nx-navy);font-size:24px;line-height:1;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.nx-arrow:hover{background:var(--nx-g-t);border-color:var(--nx-g-t);color:#fff}
.nx-dots{display:flex;justify-content:center;gap:8px;margin-top:22px}
.nx-dot{width:9px;height:9px;border-radius:50%;border:0;padding:0;background:#c8d2da;cursor:pointer;transition:background .2s,width .2s}
.nx-dot.is-active{background:var(--nx-o);width:26px;border-radius:5px}
/* flipbox megoldások */
.nx-flip{perspective:1200px;height:260px;outline:none}
.nx-flip-in{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .6s cubic-bezier(.4,0,.2,1)}
.nx-flip:hover .nx-flip-in,.nx-flip:focus-visible .nx-flip-in,.nx-flip.is-flipped .nx-flip-in{transform:rotateY(180deg)}
.nx-flip-f,.nx-flip-b{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:12px;overflow:hidden}
.nx-flip-f{background-size:cover;background-position:center;display:flex;align-items:flex-end;padding:22px}
.nx-flip-f::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(15,31,47,.88) 0%,rgba(15,31,47,.35) 55%,rgba(15,31,47,.1) 100%)}
.nx-flip-name{position:relative;z-index:1;color:#fff;font-size:19px;font-weight:700;text-shadow:0 1px 3px rgba(0,0,0,.4)}
.nx-flip-b{transform:rotateY(180deg);background:var(--nx-navy);color:#fff;display:flex;flex-direction:column;justify-content:center;padding:26px;border-top:4px solid var(--nx-o)}
.nx-flip-b h3{font-size:18px;margin:0 0 10px;color:#fff}
.nx-flip-b p{font-size:14px;line-height:1.6;margin:0;color:rgba(255,255,255,.86)}
.nx-flip-link{margin-top:14px;font-size:13px;font-weight:600;color:#8dc056;letter-spacing:.04em}
/* animált folyamatjelző sáv */
.nx-progress{position:relative;height:6px;border-radius:3px;background:rgba(255,255,255,.14);margin:48px 0 0;overflow:hidden}
.nx-progress-bar{position:absolute;inset:0 auto 0 0;width:0;border-radius:3px;background:linear-gradient(90deg,var(--nx-g),var(--nx-b) 55%,var(--nx-o));transition:width 1.8s cubic-bezier(.4,0,.2,1)}
.nx-progress.is-on .nx-progress-bar{width:100%}
.nx-steps{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin:26px 0 0;padding:0}
.nx-step h3{font-size:17px;margin:12px 0 8px;color:#fff}
.nx-step p{font-size:14px;line-height:1.65;color:rgba(255,255,255,.78);margin:0}
.nx-step-n{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.2);font-weight:700;font-size:14px;color:#fff}
.nx-steps .nx-step:nth-child(1) .nx-step-n{border-color:var(--nx-g);color:#8dc056}
.nx-steps .nx-step:nth-child(2) .nx-step-n{border-color:var(--nx-b);color:var(--nx-b)}
.nx-steps .nx-step:nth-child(3) .nx-step-n{border-color:var(--nx-o);color:var(--nx-o)}
.nx-steps .nx-step:nth-child(4) .nx-step-n{border-color:var(--nx-g);color:#8dc056}
/* kapcsolat szekció */
.nx-contact{display:grid;grid-template-columns:1fr 1.1fr;gap:56px;align-items:start}
.nx-contact-list{list-style:none;margin:28px 0 0;padding:0;display:grid;gap:14px}
.nx-contact-list li{display:flex;align-items:center;gap:12px;font-size:16px;color:var(--nx-navy)}
.nx-contact-list .nx-ic{width:40px;height:40px;background:#fff;border:1px solid var(--nx-line);border-radius:10px}
.nx-contact-list .nx-ic svg{width:20px;height:20px}
.nx-contact-list a{color:var(--nx-navy);text-decoration:none;font-weight:600}
.nx-contact-list a:hover{color:var(--nx-g-t)}
.nx-contact-form{background:#fff;border:1px solid var(--nx-line);border-radius:14px;padding:32px;box-shadow:0 10px 30px rgba(15,31,47,.06)}
.nx-contact-form .ff-btn-submit{background:var(--nx-g-t) !important;border-color:var(--nx-g-t) !important;color:#fff !important}
/* webshop kategória-szűrő */
.nx-catbar{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 32px}
.nx-cat{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--nx-line);background:#fff;border-radius:999px;padding:9px 18px;font-size:14px;font-weight:600;color:var(--nx-navy);text-decoration:none;transition:background .2s,color .2s,border-color .2s}
.nx-cat:hover,.nx-cat.is-active{background:var(--nx-g-t);border-color:var(--nx-g-t);color:#fff}
.nx-cat span{font-size:12px;opacity:.65;font-weight:500}
.nx-cat.is-empty{opacity:.62}
.nx-cat-note{background:#fff;border:1px solid var(--nx-line);border-left:4px solid var(--nx-o);border-radius:10px;padding:20px 24px;margin:0 0 28px;color:var(--nx-ink);font-size:15px;line-height:1.6}
/* közösségi ikonok */
.nx-social{display:flex;gap:10px;align-items:center}
.nx-social a{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.24);color:#fff;transition:background .2s,border-color .2s,transform .2s}
.nx-social a svg{width:17px;height:17px;fill:currentColor}
.nx-social a:hover{transform:translateY(-2px)}
.nx-social a[data-p="facebook"]:hover{background:var(--nx-b);border-color:var(--nx-b)}
.nx-social a[data-p="instagram"]:hover{background:var(--nx-o);border-color:var(--nx-o)}
.nx-social a[data-p="linkedin"]:hover{background:var(--nx-b);border-color:var(--nx-b)}
.nx-social a[data-p="tiktok"]:hover{background:var(--nx-g);border-color:var(--nx-g)}
.ct-header .nx-social a{border-color:rgba(255,255,255,.35)}
.nx-footer-legal{display:flex;flex-wrap:wrap;gap:8px 26px;align-items:center;justify-content:center;padding:6px 0}
.nx-footer-legal a{color:rgba(255,255,255,.86);text-decoration:none;font-size:14px}
.nx-footer-legal a:hover{color:#8dc056}
.nx-footer-bar{display:flex;flex-wrap:wrap;gap:18px;align-items:center;justify-content:space-between}
/* reszponzív */
@media (max-width:1100px){.nx-grid--5{grid-template-columns:repeat(3,1fr)}.nx-slide{flex-basis:50%}}
@media (max-width:900px){.nx-contact{grid-template-columns:1fr;gap:34px}.nx-steps{grid-template-columns:repeat(2,1fr)}.nx-grid--sv{grid-template-columns:repeat(2,1fr)}}
@media (max-width:781px){
.nx-section{padding:56px 0}
.nx-grid{margin-top:30px;gap:14px}
.nx-grid--5,.nx-grid--3{grid-template-columns:repeat(2,1fr)}
.nx-slide{flex-basis:100%}
.nx-flip{height:230px}
.nx-contact-form{padding:22px}
.nx-arrow{width:38px;height:38px}
}
@media (max-width:520px){.nx-grid--5,.nx-grid--3,.nx-grid--sv{grid-template-columns:1fr}.nx-steps{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){
.nx-mq-track{animation:none}
.nx-track,.nx-flip-in,.nx-progress-bar{transition:none}
}
