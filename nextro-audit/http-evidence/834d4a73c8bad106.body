</style>
<script id="nextro-review-js">
(function(){
/* --- referencia-slider --- */
document.querySelectorAll('[data-nx-slider]').forEach(function(root){
var track = root.querySelector('.nx-track');
var slides = root.querySelectorAll('.nx-slide');
var dots = (root.parentNode.querySelector('.nx-dots') || root).querySelectorAll('.nx-dot');
if(!track || !slides.length) return;
var i = 0, timer = null;
var vp = root.querySelector('.nx-viewport');
function perView(){ var w = vp.clientWidth; return w > 1000 ? 3 : (w > 640 ? 2 : 1); }
function maxI(){ return Math.max(0, slides.length - perView()); }
function layout(){
var w = vp.clientWidth / perView();
slides.forEach(function(s){ s.style.width = w + 'px'; });
return w;
}
function go(n){
var w = layout();
i = n < 0 ? maxI() : (n > maxI() ? 0 : n);
track.style.transform = 'translateX(' + (-i * w) + 'px)';
var mx = maxI();
dots.forEach(function(d,k){
d.style.display = k <= mx ? '' : 'none';
d.classList.toggle('is-active', k === i);
});
}
root.querySelector('.nx-arrow--next').addEventListener('click', function(){ go(i+1); });
root.querySelector('.nx-arrow--prev').addEventListener('click', function(){ go(i-1); });
dots.forEach(function(d,k){ d.addEventListener('click', function(){ go(k); }); });
function play(){ timer = setInterval(function(){ go(i+1); }, 6500); }
function stop(){ clearInterval(timer); }
root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', play);
window.addEventListener('resize', function(){ go(Math.min(i, maxI())); });
go(0);
if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches) play();
});
/* --- flipbox: érintésre is forduljon --- */
document.querySelectorAll('.nx-flip').forEach(function(f){
f.addEventListener('click', function(){ f.classList.toggle('is-flipped'); });
f.addEventListener('keydown', function(e){
if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); f.classList.toggle('is-flipped'); }
});
});
/* --- animált folyamatjelző sáv --- */
var bars = document.querySelectorAll('[data-nx-progress]');
if(bars.length){
if('IntersectionObserver' in window){
var io = new IntersectionObserver(function(es){
es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('is-on'); io.unobserve(e.target); } });
}, {threshold: .35});
bars.forEach(function(b){ io.observe(b); });
} else {
bars.forEach(function(b){ b.classList.add('is-on'); });
}
}
})();
</script>
