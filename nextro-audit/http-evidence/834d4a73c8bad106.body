/* NEXTRO – arculati finomhangolás */
.ct-header [data-row="top"] { background-color: #0F1F2F !important; }
.ct-header [data-row="top"] [data-id^="contacts"],
.ct-header [data-row="top"] [data-id^="contacts"] *,
.ct-header [data-row="top"] a, .ct-header [data-row="top"] svg { color: #ffffff !important; fill: currentColor !important; }
.ct-header [data-row="top"] a:hover { color: #8CC63F !important; }
.ct-header [data-id="logo"] .site-logo-container img,
.ct-header [data-id="logo"] img { max-height: 34px !important; height: auto !important; width: auto !important; }
.ct-header [data-id="menu"] .ct-menu-link { font-size: 13px !important; }
.ct-header [data-id="menu"] > ul > li { --menu-items-spacing: 16px; }
.dsp-credit { display: inline-block; margin-left: 12px; color: rgba(255,255,255,.85); }
.ct-header [data-row="top"] .contact-text,
.ct-header [data-row="top"] .contact-info,
.ct-header [data-row="top"] li { color: #ffffff !important; }
/* Űrlap: a jogi linkek legyenek olvashatók a zöld hátterű dobozban */
.ff-el-form-check-label a, .ff_t_c a, .ff-el-tc a { color: #ffffff !important; text-decoration: underline !important; }
.ff-el-form-check-label, .ff-el-tc, .ff_t_c { color: #ffffff !important; }
</style>
